[Unit]
Description=Kontur+ Gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/kontur
EnvironmentFile=/var/www/kontur/.env
ExecStart=/var/www/kontur/.venv/bin/gunicorn config.wsgi:application \
  --bind 127.0.0.1:8000 \
  --workers 3 \
  --timeout 60 \
  --access-logfile /var/log/kontur/access.log \
  --error-logfile /var/log/kontur/error.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
