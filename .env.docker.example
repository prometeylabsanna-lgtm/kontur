# Copy to /var/www/kontur/.env on the Droplet. Never commit the live file.

SECRET_KEY=change-me-generate-with-python-secrets
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings

POSTGRES_DB=kontur
POSTGRES_USER=kontur
POSTGRES_PASSWORD=change-me-strong-alnum-only

# HTTP-first on the existing Droplet. Do not leave the token DROPLET_IP.
ALLOWED_HOSTS=68.183.210.146,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://68.183.210.146

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

NGINX_CONF=docker.conf
HTTP_PORT=80

# After DNS A-records + certbot:
# NGINX_CONF=docker.prod.conf
# ALLOWED_HOSTS=kontur.plus,www.kontur.plus,68.183.210.146,127.0.0.1,localhost,web
# CSRF_TRUSTED_ORIGINS=https://kontur.plus,https://www.kontur.plus
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True

GTM_ID=
META_PIXEL_ID=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
