SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Analytics (loaded only after cookie consent "Прийняти")
GTM_ID=
META_PIXEL_ID=

# Google Places API (New) — рейтинг і відгуки (#proof)
# Увімкніть Places API (New) у Google Cloud, обмежте ключ по IP сервера.
GOOGLE_PLACES_API_KEY=
# Опційно: Place ID (ChIJ…). Або вкажіть у CMS «Відгуки та кейси».
GOOGLE_PLACE_ID=

